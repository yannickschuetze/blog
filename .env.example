# Copy to .env for local development. On netcup, set these in Plesk: Node.js > Custom environment variables.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yannicksblog
DB_USER=yannicksblog
DB_PASSWORD=change-me
ADMIN_USER=yannick
# Create with: npm run admin:password
ADMIN_PASSWORD_HASH=
# Where uploaded drawings are stored. Keep it outside the build output so deploys keep them.
UPLOAD_DIR=./uploads
# Public address of the blog (used for RSS, canonical links and trusted proxy headers)
SITE_URL=https://example.com
